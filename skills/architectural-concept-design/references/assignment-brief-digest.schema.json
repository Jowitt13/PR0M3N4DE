{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/assignment-brief-digest/1.0.0",
  "title": "Assignment Brief Digest",
  "description": "Literal-only digest of an assignment brief intake. Every requirement keeps its source locator and one coverage status; design interpretations, options, area allocations, and spatial recommendations have no representation in this contract. A digest remains pending until an explicit human confirmation record is bound by the confirm subcommand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest_kind",
    "input_hash",
    "project_title",
    "input_files",
    "requirements",
    "conflicts",
    "unknowns",
    "clarification_questions",
    "human_notes",
    "coverage_summary",
    "human_confirmation",
    "downstream",
    "not_generated"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "digest_kind": {"const": "assignment_brief_digest"},
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical intake this digest was built from. Intake provenance only; it is not the human-confirmation binding."
    },
    "project_title": {"type": "string", "minLength": 1},
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_label", "file_type", "readability"],
        "properties": {
          "path_label": {"type": "string", "minLength": 1},
          "file_type": {"type": "string", "minLength": 1},
          "readability": {"enum": ["readable", "partial", "unreadable"]},
          "unreadable_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "category", "concise_text", "status", "literal_only", "source_locator"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$",
            "description": "Deterministic digest-local requirement identifier."
          },
          "category": {"$ref": "https://architecture-pre-design-skills.local/schemas/assignment-brief-intake/1.0.0#/$defs/requirement_category"},
          "concise_text": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["included", "duplicate_merged", "conflict", "missing", "unreadable", "deferred_with_reason"],
            "description": "Coverage status. missing and unreadable are derived from declared unknowns only."
          },
          "literal_only": {
            "const": true,
            "description": "Every digest requirement is a literal brief fact, never a design interpretation."
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "description": "File label plus in-file locator for segment-backed requirements; a declared-unknown reference otherwise."
          },
          "source_segment_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
            "description": "Supporting segments; empty exactly for missing and unreadable requirements."
          },
          "merged_from_segment_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
            "description": "All duplicate locations for duplicate_merged requirements."
          },
          "conflict_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^CONF-[0-9]{3,}$"},
            "description": "Declared conflicts for conflict requirements."
          },
          "deferred_reason": {"type": "string", "minLength": 1},
          "unknown_id": {
            "type": "string",
            "pattern": "^UNK-[0-9]{3,}$",
            "description": "Required exactly for missing and unreadable requirements derived from a declared unknown."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"enum": ["missing", "unreadable"]}},
              "required": ["status"]
            },
            "then": {
              "required": ["unknown_id"],
              "properties": {
                "source_segment_ids": {"maxItems": 0}
              }
            },
            "else": {
              "not": {"required": ["unknown_id"]},
              "properties": {
                "source_segment_ids": {"minItems": 1}
              },
              "required": ["source_segment_ids"]
            }
          },
          {
            "if": {
              "properties": {"status": {"const": "duplicate_merged"}},
              "required": ["status"]
            },
            "then": {"required": ["merged_from_segment_ids"]},
            "else": {"not": {"required": ["merged_from_segment_ids"]}}
          },
          {
            "if": {
              "properties": {"status": {"const": "conflict"}},
              "required": ["status"]
            },
            "then": {"required": ["conflict_ids"]},
            "else": {"not": {"required": ["conflict_ids"]}}
          },
          {
            "if": {
              "properties": {"status": {"const": "deferred_with_reason"}},
              "required": ["status"]
            },
            "then": {"required": ["deferred_reason"]},
            "else": {"not": {"required": ["deferred_reason"]}}
          }
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "description", "segment_ids", "locators"],
        "properties": {
          "conflict_id": {"type": "string", "pattern": "^CONF-[0-9]{3,}$"},
          "description": {"type": "string", "minLength": 1},
          "segment_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"}
          },
          "locators": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1},
            "description": "Resolved file and locator for each disagreeing segment; no winner is chosen."
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unknown_id", "expected_category", "kind", "description"],
        "properties": {
          "unknown_id": {"type": "string", "pattern": "^UNK-[0-9]{3,}$"},
          "expected_category": {"$ref": "https://architecture-pre-design-skills.local/schemas/assignment-brief-intake/1.0.0#/$defs/requirement_category"},
          "kind": {"enum": ["missing", "unreadable"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "clarification_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1},
      "description": "At most three focused clarification questions at a time."
    },
    "human_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "text"],
        "properties": {
          "note_id": {"type": "string", "pattern": "^NOTE-[0-9]{3,}$"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_file_count",
        "unreadable_file_count",
        "segment_count",
        "covered_segment_count",
        "uncovered_segments",
        "requirement_count_by_status"
      ],
      "properties": {
        "input_file_count": {"type": "integer", "minimum": 1},
        "unreadable_file_count": {"type": "integer", "minimum": 0},
        "segment_count": {"type": "integer", "minimum": 0},
        "covered_segment_count": {"type": "integer", "minimum": 0},
        "uncovered_segments": {
          "type": "array",
          "items": {"type": "string", "pattern": "^SEG-[0-9]{3,}$"},
          "description": "Must be empty for an emitted digest; the builder fails closed otherwise."
        },
        "requirement_count_by_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "duplicate_merged", "conflict", "missing", "unreadable", "deferred_with_reason"],
          "properties": {
            "included": {"type": "integer", "minimum": 0},
            "duplicate_merged": {"type": "integer", "minimum": 0},
            "conflict": {"type": "integer", "minimum": 0},
            "missing": {"type": "integer", "minimum": 0},
            "unreadable": {"type": "integer", "minimum": 0},
            "deferred_with_reason": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "human_confirmation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "pending"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confirmed_by", "confirmed_at", "action", "pending_digest_sha256"],
          "properties": {
            "status": {"const": "confirmed"},
            "confirmed_by": {
              "type": "string",
              "minLength": 1,
              "description": "A human record label; agent labels are rejected by the builder."
            },
            "confirmed_at": {
              "type": "string",
              "description": "Timezone-qualified RFC 3339 date-time supplied by the human confirmation record."
            },
            "action": {"const": "CONFIRM_BRIEF_DIGEST"},
            "pending_digest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the canonical pending digest document this confirmation was bound to; preserved for downstream state-package traceability."
            }
          }
        }
      ],
      "description": "Always pending when built; confirmed only through the confirm subcommand with a valid human record whose pending_digest_sha256 matches the supplied pending digest document exactly."
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumable_by", "mapping_note"],
      "properties": {
        "consumable_by": {"type": "string", "minLength": 1},
        "mapping_note": {"type": "string", "minLength": 1}
      }
    },
    "not_generated": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "Content classes this digest never generates."
    }
  }
}
