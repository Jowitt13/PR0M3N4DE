{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-spatial-program/1.0.0",
  "title": "Student Spatial Program",
  "description": "A deterministic student spatial program derived from one confirmed digest, its exact start board projection, and one confirmed human-authored program draft. JSON data only: no HTML, PPTX, image, plan, or massing. It never invents spaces, areas, relations, or design content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_kind", "source_binding", "student_view"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "program_kind": {"const": "student_spatial_program"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_input_hash",
        "confirmed_digest_sha256",
        "pending_digest_sha256",
        "start_board_sha256",
        "confirmed_program_draft_sha256",
        "pending_program_draft_sha256"
      ],
      "description": "Machine traceability layer only; never part of the default student-facing content.",
      "properties": {
        "digest_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_board_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "spaces_by_zone",
        "area_summary",
        "relations",
        "unresolved_brief_items",
        "unresolved_program_items",
        "clarification_questions",
        "next_action",
        "boundaries"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "program_confirmed_ready_for_next_step"},
        "spaces_by_zone": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "description": "Exactly the five functional zones in fixed order: public, internal_staff, service_support, shared, unresolved.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zone", "spaces"],
            "properties": {
              "zone": {"enum": ["public", "internal_staff", "service_support", "shared", "unresolved"]},
              "spaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "activity_profile", "area_status", "origin_basis"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "activity_profile": {"enum": ["active", "quiet", "mixed", "unresolved"]},
                    "area_status": {"enum": ["brief_stated", "human_working", "unresolved"]},
                    "area_value_m2": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "Present exactly when area_status is brief_stated or human_working."
                    },
                    "origin_basis": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable brief locator or human working explanation, copied from the confirmed draft."
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {"area_status": {"enum": ["brief_stated", "human_working"]}},
                        "required": ["area_status"]
                      },
                      "then": {"required": ["area_value_m2"]},
                      "else": {"not": {"required": ["area_value_m2"]}}
                    }
                  ]
                }
              }
            }
          }
        },
        "area_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brief_stated_area_subtotal_m2",
            "human_working_area_subtotal_m2",
            "scheduled_area_m2",
            "unresolved_area_spaces",
            "area_status"
          ],
          "properties": {
            "brief_stated_area_subtotal_m2": {"type": "number", "minimum": 0},
            "human_working_area_subtotal_m2": {"type": "number", "minimum": 0},
            "scheduled_area_m2": {"type": "number", "minimum": 0},
            "unresolved_area_spaces": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "description": "Names of spaces without an area value; never counted in any total."
            },
            "area_status": {
              "enum": ["partial", "complete"],
              "description": "complete only means every current space has a number; it is never a final, approval, or constructibility conclusion."
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_space", "to_space", "kind", "basis"],
            "properties": {
              "from_space": {"type": "string", "minLength": 1},
              "to_space": {"type": "string", "minLength": 1},
              "kind": {"enum": ["must_be_near", "prefer_be_near", "must_be_separate", "shared_support"]},
              "basis": {"type": "string", "minLength": 1}
            }
          }
        },
        "unresolved_brief_items": {
          "type": "array",
          "description": "Carried verbatim from the confirmed start board.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "description"],
            "properties": {
              "kind": {"enum": ["conflict", "missing", "unreadable", "deferred_with_reason"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "unresolved_program_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "note"],
            "properties": {
              "kind": {"enum": ["program_input", "area"]},
              "name": {"type": "string", "minLength": 1},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"enum": ["resolve_program_gaps", "dimension_candidates"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
