{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/user-authorized-media/1.0.0",
  "title": "User-Authorized Noncommercial Presentation Media",
  "description": "An offline, per-run authorization and local-media manifest contract. It validates existing local artifacts only; it is not a downloader, crawler plan, renderer, rights clearance, or presentation-handoff adaptation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization", "manifest"],
  "properties": {
    "authorization": {"$ref": "#/$defs/Authorization"},
    "manifest": {"$ref": "#/$defs/Manifest"}
  },
  "$defs": {
    "ProjectId": {"type": "string", "pattern": "^P-[A-Za-z0-9][A-Za-z0-9-]*$"},
    "CandidateId": {"type": "string", "pattern": "^RC-[0-9]{3,}$"},
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "HttpsLocator": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$", "minLength": 1},
    "Authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "authorization_id", "authorized_by", "authorized_at", "project_id", "purpose", "selected_candidate_ids", "authorization_mode", "acknowledgement"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "authorization_id": {"type": "string", "pattern": "^UMA-[0-9]{3,}$"},
        "authorized_by": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"},
        "project_id": {"$ref": "#/$defs/ProjectId"},
        "purpose": {"const": "noncommercial_project_presentation"},
        "selected_candidate_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/CandidateId"}},
        "authorization_mode": {"const": "user_directed_noncommercial_use"},
        "acknowledgement": {"const": "This direction is not a license or permission claim."}
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "manifest_id", "project_id", "authorization_id", "created_at", "assets"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "manifest_id": {"type": "string", "pattern": "^UMM-[0-9]{3,}$"},
        "project_id": {"$ref": "#/$defs/ProjectId"},
        "authorization_id": {"type": "string", "pattern": "^UMA-[0-9]{3,}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Asset"}}
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "project_id", "source_candidate_id", "source_locator", "retrieved_at", "sha256", "content_type", "asset_kind", "relative_path", "intended_use", "rights_status", "user_authorization_id", "attribution_text", "access_result"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^UMAS-[0-9]{3,}$"},
        "project_id": {"$ref": "#/$defs/ProjectId"},
        "source_candidate_id": {"$ref": "#/$defs/CandidateId"},
        "source_locator": {"$ref": "#/$defs/HttpsLocator"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "content_type": {"enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"]},
        "asset_kind": {"enum": ["image", "drawing", "pdf"]},
        "relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "intended_use": {"const": "noncommercial_project_presentation"},
        "rights_status": {"const": "user_authorized_noncommercial_use"},
        "user_authorization_id": {"type": "string", "pattern": "^UMA-[0-9]{3,}$"},
        "attribution_text": {"type": "string", "minLength": 1},
        "access_result": {"const": "normal_access_success"}
      }
    }
  }
}
