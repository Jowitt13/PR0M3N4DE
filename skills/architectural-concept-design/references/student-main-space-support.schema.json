{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-main-space-support-framework/1.0.0",
  "title": "Student Main Space and Supporting Space Framework",
  "description": "A closed deterministic projection of one exact ARCH-108 state handoff and one human-confirmed organization draft. It carries human-written roles, support relationships, and sequence intentions only; it makes no geometric, site, design, or professional conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_kind", "source_binding", "student_view", "framework_contract"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "framework_kind": {"const": "student_main_space_support_framework"},
    "source_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["state_handoff_sha256", "confirmed_draft_sha256", "pending_draft_sha256"],
      "properties": {
        "state_handoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "student_view": {
      "type": "object", "additionalProperties": false,
      "required": ["project_title", "stage", "space_roles", "support_relationships", "sequence_intents", "unresolved_items", "clarification_questions", "next_action", "boundaries_statement"],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "main_space_support_framework_confirmed"},
        "space_roles": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["space_name", "role", "note"], "properties": {"space_name": {"type": "string", "minLength": 1}, "role": {"enum": ["main_space", "supporting_space", "shared_service"]}, "note": {"type": "string", "minLength": 1}}}
        },
        "support_relationships": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["main_space_name", "support_space_name", "relationship_kind", "note"], "properties": {"main_space_name": {"type": "string", "minLength": 1}, "support_space_name": {"type": "string", "minLength": 1}, "relationship_kind": {"enum": ["direct_support", "shared_support", "buffered_transition"]}, "note": {"type": "string", "minLength": 1}}}
        },
        "sequence_intents": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["level_label", "ordered_space_names", "intent_kind", "note"], "properties": {"level_label": {"type": "string", "minLength": 1}, "ordered_space_names": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "intent_kind": {"enum": ["active_to_quiet", "open_to_contained", "public_to_private", "flexible_to_defined"]}, "note": {"type": "string", "minLength": 1}}}
        },
        "unresolved_items": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["subject_space_names", "reason"], "properties": {"subject_space_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "minLength": 1}}}
        },
        "clarification_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "next_action": {"type": "object", "additionalProperties": false, "required": ["action", "description"], "properties": {"action": {"enum": ["resolve_main_space_support_gaps", "human_refine_spatial_sequence"]}, "description": {"type": "string", "minLength": 1}}},
        "boundaries_statement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "framework_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed_available", "must_not_infer", "invalidated_by_upstream_change", "prohibited_outputs"],
      "properties": {
        "confirmed_available": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_infer": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "invalidated_by_upstream_change": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
