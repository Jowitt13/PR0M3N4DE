{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-circulation-environment/1.0.0",
  "title": "Student Circulation and Environmental Intent Framework",
  "description": "A deterministic projection of the student's own circulation relations, vertical movement intentions, and environmental preferences over one confirmed floor zoning framework. It decides no entrance, core, stair, lift, ramp position, orientation, wind, sun, site conclusion, coordinate, plan, massing, grid, elevation, or height, and recommends, ranks, scores, selects, or generates nothing. JSON data only: no PPTX, HTML, image, or drawing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_kind", "source_binding", "student_view"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "framework_kind": {"const": "student_circulation_environment_framework"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_input_hash",
        "confirmed_digest_sha256",
        "pending_digest_sha256",
        "start_board_sha256",
        "confirmed_program_draft_sha256",
        "pending_program_draft_sha256",
        "confirmed_program_sha256",
        "pending_dimension_draft_sha256",
        "confirmed_dimension_draft_sha256",
        "confirmed_dimension_plan_sha256",
        "dimension_selection_sha256",
        "pending_floor_zoning_draft_sha256",
        "confirmed_floor_zoning_draft_sha256",
        "floor_zoning_framework_sha256",
        "pending_circulation_environment_draft_sha256",
        "confirmed_circulation_environment_draft_sha256"
      ],
      "properties": {
        "digest_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_board_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimension_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "floor_zoning_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "circulation_relations",
        "vertical_movements",
        "environmental_intents",
        "unresolved_items",
        "clarification_questions",
        "next_action",
        "boundaries_statement"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "circulation_environment_intent_confirmed"},
        "circulation_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_zone", "to_zone", "flow_scope", "directionality", "note"],
            "properties": {
              "from_zone": {"type": "string", "minLength": 1},
              "to_zone": {"type": "string", "minLength": 1},
              "flow_scope": {"enum": ["public", "internal", "shared"]},
              "directionality": {"enum": ["one_way", "two_way"]},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "vertical_movements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_zone", "from_level", "to_zone", "to_level", "mode", "flow_scope", "note"],
            "properties": {
              "from_zone": {"type": "string", "minLength": 1},
              "from_level": {"type": "string", "minLength": 1},
              "to_zone": {"type": "string", "minLength": 1},
              "to_level": {"type": "string", "minLength": 1},
              "mode": {"enum": ["stair", "lift", "ramp", "other"]},
              "flow_scope": {"enum": ["public", "internal", "shared"]},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "environmental_intents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_kind", "target_name", "topic", "preference", "note"],
            "properties": {
              "target_kind": {"enum": ["zone", "space"]},
              "target_name": {"type": "string", "minLength": 1},
              "topic": {"enum": ["daylight", "view", "noise", "ventilation"]},
              "preference": {"enum": ["prefer", "avoid", "neutral"]},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_kind", "target_kind", "target_name", "reason"],
            "properties": {
              "subject_kind": {"enum": ["circulation_relation", "vertical_movement", "environmental_intent"]},
              "target_kind": {"enum": ["zone", "level", "space"]},
              "target_name": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"enum": ["resolve_circulation_environment_gaps", "massing_grid_height_hypotheses"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries_statement": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
