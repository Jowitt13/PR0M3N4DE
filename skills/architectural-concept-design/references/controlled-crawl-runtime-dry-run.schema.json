{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/controlled-crawl-runtime-dry-run/1.0.0",
  "title": "Controlled Crawl Runtime Dry-run",
  "description": "Offline-only preflight for a separately installed locked Crawl4AI runtime. It never starts, installs, repairs, or contacts that runtime.",
  "$defs": {
    "RuntimeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_version", "runtime_id", "python_version", "distribution", "browser_engine", "project_definition_sha256", "project_lock_sha256", "browser_lock_sha256", "browser_metadata_sha256", "prohibited_capabilities", "upstream_license"],
      "properties": {
        "receipt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "python_version": {"type": "string", "pattern": "^3\\.13\\.[0-9]+$"},
        "distribution": {"type": "object"},
        "browser_engine": {"type": "object"},
        "project_definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "browser_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "browser_metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prohibited_capabilities": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
        "upstream_license": {"type": "object"}
      }
    },
    "DryRunInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "execution_mode", "plan", "runtime_root", "lock_version", "runtime_receipt"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "execution_mode": {"enum": ["dry_run", "live", "execute", "browser", "network"]},
        "plan": {"type": "object"},
        "runtime_root": {"type": ["string", "null"], "maxLength": 600},
        "lock_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime_receipt": {"$ref": "#/$defs/RuntimeReceipt"}
      }
    },
    "BudgetConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduled_page_count", "maximum_page_count", "maximum_depth", "minimum_delay_ms"],
      "properties": {
        "scheduled_page_count": {"type": "integer", "minimum": 0},
        "maximum_page_count": {"type": "integer", "minimum": 1},
        "maximum_depth": {"type": "integer", "minimum": 0},
        "minimum_delay_ms": {"type": "integer", "minimum": 1}
      }
    },
    "DryRunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "outcome", "plan_id", "source_domain", "registry_version", "runtime_id", "runtime_status", "invocation_kind", "controls_confirmation", "budget_confirmation", "reason_codes"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "ok": {"type": "boolean"},
        "outcome": {"enum": ["ready_dry_run", "blocked", "dependency_unavailable"]},
        "plan_id": {"type": ["string", "null"], "pattern": "^CCP-[0-9]{3,}$"},
        "source_domain": {"type": ["string", "null"], "pattern": "^[a-z0-9.-]+$"},
        "registry_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "runtime_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
        "runtime_status": {"enum": ["receipt_and_local_layout_validated_dry_run_only", "not_available_or_not_validated"]},
        "invocation_kind": {"enum": ["isolated_runtime_dry_run_only", "none"]},
        "controls_confirmation": {"enum": ["all_controls_false", "not_confirmed"]},
        "budget_confirmation": {"type": ["object", "null"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/BudgetConfirmation"}}]},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}}
      }
    }
  }
}
