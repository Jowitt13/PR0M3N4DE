{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-spatial-transition-framework/1.0.0",
  "title": "Student Spatial Transition Framework",
  "description": "A closed deterministic projection of one exact ARCH-109 main-space-support framework and one human-confirmed spatial transition draft. It carries human-written hierarchy and transition intentions only; it makes no geometry, site, performance, or professional conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "framework_kind", "source_binding", "student_view", "framework_contract"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "framework_kind": {"const": "student_spatial_transition_framework"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_space_support_framework_sha256", "confirmed_draft_sha256", "pending_draft_sha256"],
      "properties": {
        "main_space_support_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_title", "stage", "space_hierarchy", "transition_patterns", "unresolved_items", "clarification_questions", "next_action", "boundaries_statement"],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "spatial_transition_framework_confirmed"},
        "space_hierarchy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["space_name", "role", "note"], "properties": {"space_name": {"type": "string", "minLength": 1}, "role": {"enum": ["main_space", "supporting_space", "shared_service"]}, "note": {"type": "string", "minLength": 1}}}
        },
        "transition_patterns": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["from_space_name", "to_space_name", "transition_kind", "note"], "properties": {"from_space_name": {"type": "string", "minLength": 1}, "to_space_name": {"type": "string", "minLength": 1}, "transition_kind": {"enum": ["gradual_opening", "gradual_enclosure", "buffered_transition", "interwoven_access", "remain_independent"]}, "note": {"type": "string", "minLength": 1}}}
        },
        "unresolved_items": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["from_space_name", "to_space_name", "reason"], "properties": {"from_space_name": {"type": "string", "minLength": 1}, "to_space_name": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}
        },
        "clarification_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "next_action": {"type": "object", "additionalProperties": false, "required": ["action", "description"], "properties": {"action": {"enum": ["resolve_spatial_transition_gaps", "human_review_spatial_transition_framework"]}, "description": {"type": "string", "minLength": 1}}},
        "boundaries_statement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "framework_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_available", "must_not_infer", "invalidated_by_upstream_change", "prohibited_outputs"],
      "properties": {
        "confirmed_available": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_infer": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "invalidated_by_upstream_change": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
