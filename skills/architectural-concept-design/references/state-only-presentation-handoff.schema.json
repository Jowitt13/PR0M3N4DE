{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/state-only-presentation-handoff/2.0.0",
  "title": "State-only Architecture Presentation Handoff",
  "description": "A real-project, local-state, audience-ready presentation handoff with no external precedent or third-party media transfer. Version 2.0.0 adds the shared four-layer audience-copy contract; a 1.0.0 handoff is retired and fails closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "mode",
    "handoff_id",
    "project_id",
    "project_display_name",
    "state_package",
    "human_design_decision",
    "architectural_chain",
    "deck_framework",
    "local_assets",
    "audience_context",
    "public_claims",
    "rendering_boundary"
  ],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "mode": {"const": "STATE_ONLY_TEAM_ORIGINAL"},
    "handoff_id": {"type": "string", "pattern": "^SOH-[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^P-[A-Za-z0-9][A-Za-z0-9-]*$"},
    "project_display_name": {"type": "string", "minLength": 1},
    "state_package": {"$ref": "#/$defs/StatePackageReference"},
    "human_design_decision": {"$ref": "#/$defs/HumanDesignDecision"},
    "architectural_chain": {"$ref": "#/$defs/ArchitecturalChain"},
    "deck_framework": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/DeckPage"}
    },
    "local_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/LocalAsset"}
    },
    "audience_context": {"$ref": "#/$defs/AudienceContext"},
    "public_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/PublicClaim"}
    },
    "rendering_boundary": {"$ref": "#/$defs/RenderingBoundary"}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "AudienceStringList": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "AudienceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_language", "audience_type", "setting", "key_takeaway", "planned_minutes"],
      "properties": {
        "presentation_language": {"type": "string", "pattern": "^[a-zA-Z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
        "audience_type": {"enum": ["studio_critic_review", "jury_review", "client_briefing", "public_exhibition", "teaching_demo"]},
        "setting": {"type": "string", "minLength": 1},
        "key_takeaway": {"type": "string", "minLength": 1},
        "planned_minutes": {"type": "integer", "minimum": 5, "maximum": 30},
        "audience_already_knows": {"$ref": "#/$defs/AudienceStringList"},
        "internal_only_topics": {"$ref": "#/$defs/AudienceStringList"},
        "human_claim_confirmations_required": {"$ref": "#/$defs/AudienceStringList"}
      }
    },
    "VisibleSlideCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": {"type": "string", "minLength": 1, "maxLength": 80},
        "supporting_points": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "SpeakerNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_hint"],
      "properties": {
        "delivery_hint": {"type": "string", "minLength": 1},
        "evidence_and_limitations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "PublicClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "quoted_text", "claim_type", "evidence_ids", "evidence_status", "limitations", "allowed_for_public_display", "confirmed_by"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "quoted_text": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["permission", "approval", "regulatory_compliance", "exemption", "area_basis"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_status": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1},
        "allowed_for_public_display": {"type": "boolean"},
        "confirmed_by": {"type": "string", "minLength": 1}
      }
    },
    "StatePackageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hash", "output_hash", "validated_at"],
      "properties": {
        "input_hash": {"$ref": "#/$defs/Sha256"},
        "output_hash": {"$ref": "#/$defs/Sha256"},
        "validated_at": {"type": "string", "format": "date-time"}
      }
    },
    "HumanDesignDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_type", "chosen_option_id", "criteria_ids", "decided_by", "recorded_in_validated_state"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^D-[0-9]{3,}$"},
        "decision_type": {"const": "select"},
        "chosen_option_id": {"type": "string", "pattern": "^O-[0-9]{3,}$"},
        "criteria_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^K-[0-9]{3,}$"}
        },
        "decided_by": {"type": "string", "minLength": 1},
        "recorded_in_validated_state": {"const": true}
      }
    },
    "ArchitecturalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "constraint_ids", "space_ids", "relation_ids", "hypothesis_ids", "option_ids", "criterion_ids", "decision_ids", "deliverable_ids"],
      "properties": {
        "evidence_ids": {"$ref": "#/$defs/IdList"},
        "constraint_ids": {"$ref": "#/$defs/IdList"},
        "space_ids": {"$ref": "#/$defs/IdList"},
        "relation_ids": {"$ref": "#/$defs/IdList"},
        "hypothesis_ids": {"$ref": "#/$defs/IdList"},
        "option_ids": {"$ref": "#/$defs/IdList"},
        "criterion_ids": {"$ref": "#/$defs/IdList"},
        "decision_ids": {"$ref": "#/$defs/IdList"},
        "deliverable_ids": {"$ref": "#/$defs/IdList"}
      }
    },
    "IdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]-[0-9]{3,}$"}
    },
    "DeckPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "internal_purpose", "required_state_ids", "visible_state_only_notice", "visible_slide_copy", "speaker_notes", "visual_strategy"],
      "properties": {
        "page_id": {"type": "string", "pattern": "^SOP-(0[1-9]|10)$"},
        "internal_purpose": {"type": "string", "minLength": 1},
        "required_state_ids": {"$ref": "#/$defs/IdList"},
        "visible_state_only_notice": {"const": "STATE-ONLY HANDOFF — NO EXTERNAL PRECEDENT OR THIRD-PARTY MEDIA"},
        "visible_slide_copy": {"$ref": "#/$defs/VisibleSlideCopy"},
        "speaker_notes": {"$ref": "#/$defs/SpeakerNotes"},
        "visual_strategy": {"const": "team_original_diagram_only"}
      }
    },
    "LocalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "state_deliverable_id", "kind", "relative_path", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^VA-[0-9]{3,}$"},
        "state_deliverable_id": {"type": "string", "pattern": "^A-[0-9]{3,}$"},
        "kind": {"const": "team_original_diagram"},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"},
        "sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "RenderingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_name", "renderer_invoked", "network_accessed", "external_precedent_transferred", "third_party_media_packaged", "pptx_generated"],
      "properties": {
        "renderer_name": {"const": "ppt-master"},
        "renderer_invoked": {"const": false},
        "network_accessed": {"const": false},
        "external_precedent_transferred": {"const": false},
        "third_party_media_packaged": {"const": false},
        "pptx_generated": {"const": false}
      }
    }
  }
}
