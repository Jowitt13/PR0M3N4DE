{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-design-start-board/1.0.0",
  "title": "Student Design Start Board",
  "description": "A deterministic, student-readable start board derived from one confirmed AssignmentBriefDigest. It restates confirmed literal requirements, unresolved items, at most three clarification questions, and exactly one next action. It is data only: not a web UI, not a PPTX, not an option generator, not an area calculator, and not a design recommender.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "board_kind", "source_binding", "student_view"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "board_kind": {"const": "student_design_start_board"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_hash", "confirmed_digest_sha256", "pending_digest_sha256"],
      "description": "Machine traceability layer only; never part of the default student-facing content.",
      "properties": {
        "input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Intake provenance hash carried by the confirmed source digest; copied, never recomputed or invented."
        },
        "confirmed_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Canonical SHA-256 of the whole confirmed digest document this board was built from."
        },
        "pending_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The human-confirmed binding hash preserved by the source digest."
        }
      }
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "confirmed_requirements",
        "unresolved_items",
        "clarification_questions",
        "next_action",
        "boundaries"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "brief_confirmed_ready_for_programming"},
        "confirmed_requirements": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "description": "Exactly the nine requirement categories in their fixed canonical order; only included and duplicate_merged digest requirements appear here.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "items"],
            "properties": {
              "category": {
                "enum": [
                  "hard_constraint",
                  "program",
                  "site",
                  "spatial_relationship",
                  "circulation",
                  "deliverable",
                  "design_goal",
                  "scoring_focus",
                  "reference_only"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["requirement", "source_locator"],
                  "properties": {
                    "requirement": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The concise literal brief wording copied from the confirmed digest, unmodified."
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable file and in-file locator copied from the confirmed digest."
                    }
                  }
                }
              }
            }
          }
        },
        "unresolved_items": {
          "type": "array",
          "description": "Conflicts, missing information, unreadable expectations, and deferred items, each without resolution.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "description", "source_locator"],
            "properties": {
              "kind": {"enum": ["conflict", "missing", "unreadable", "deferred_with_reason"]},
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "The digest wording for the unresolved item; no winner is chosen, no value is filled in."
              },
              "source_locator": {"type": "string", "minLength": 1},
              "conflicting_locators": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "string", "minLength": 1},
                "description": "Required for conflict items: every disagreeing location, with no selected winner."
              },
              "deferred_reason": {
                "type": "string",
                "minLength": 1,
                "description": "Required for deferred_with_reason items; preserved from the confirmed digest."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {"kind": {"const": "conflict"}},
                  "required": ["kind"]
                },
                "then": {"required": ["conflicting_locators"]},
                "else": {"not": {"required": ["conflicting_locators"]}}
              },
              {
                "if": {
                  "properties": {"kind": {"const": "deferred_with_reason"}},
                  "required": ["kind"]
                },
                "then": {"required": ["deferred_reason"]},
                "else": {"not": {"required": ["deferred_reason"]}}
              }
            ]
          }
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1},
          "description": "Carried verbatim from the confirmed digest; the board never adds questions."
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"const": "program_and_area"},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Explicit statements of what this board does not decide."
        }
      }
    }
  }
}
