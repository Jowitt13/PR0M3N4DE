{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-schematic-plan-blocks/1.0.0",
  "title": "Student Schematic Plan Blocks and Local Coordinates",
  "description": "A closed, deterministic schematic plan blocks document projected from one valid ARCH-106 plan framework without unresolved items and one confirmed human-authored schematic plan draft. It carries the student-written local containers and placements with the ARCH-100 option-determined width and depth, the plan framework's relations with their verification status, and a local_schematic_coordinates_only marker. It generates no site plan, orientation, wall, door, column, building outline, massing shape, structure, regulation, cost, performance, or constructibility conclusion, and it produces no PPTX, image, HTML, drawing, or three-dimensional model. JSON data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "blocks_kind", "source_binding", "student_view"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "blocks_kind": {"const": "student_schematic_plan_blocks"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Machine traceability layer only; never part of the default student-facing content.",
      "required": [
        "digest_input_hash",
        "confirmed_digest_sha256",
        "pending_digest_sha256",
        "start_board_sha256",
        "confirmed_program_draft_sha256",
        "pending_program_draft_sha256",
        "confirmed_program_sha256",
        "pending_dimension_draft_sha256",
        "confirmed_dimension_draft_sha256",
        "confirmed_dimension_plan_sha256",
        "dimension_selection_sha256",
        "pending_floor_zoning_draft_sha256",
        "confirmed_floor_zoning_draft_sha256",
        "floor_zoning_framework_sha256",
        "pending_circulation_environment_draft_sha256",
        "confirmed_circulation_environment_draft_sha256",
        "circulation_environment_framework_sha256",
        "pending_massing_grid_height_draft_sha256",
        "confirmed_massing_grid_height_draft_sha256",
        "massing_grid_height_framework_sha256",
        "pending_student_hypothesis_comparison_draft_sha256",
        "confirmed_student_hypothesis_comparison_draft_sha256",
        "selected_comparison_document_sha256",
        "human_selection_action",
        "human_selection_candidate_key",
        "human_selection_selected_by",
        "human_selection_selected_at",
        "human_selection_source_comparison_document_sha256",
        "selected_hypothesis_state_package_sha256",
        "pending_student_plan_framework_draft_sha256",
        "confirmed_student_plan_framework_draft_sha256",
        "plan_framework_sha256",
        "pending_student_schematic_plan_draft_sha256",
        "confirmed_student_schematic_plan_draft_sha256"
      ],
      "properties": {
        "digest_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_board_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimension_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "floor_zoning_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "circulation_environment_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_massing_grid_height_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_massing_grid_height_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "massing_grid_height_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_student_hypothesis_comparison_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_student_hypothesis_comparison_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_comparison_document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The canonical JSON plus newline SHA-256 of the whole selected comparison document wrapped by the selected state package."
        },
        "human_selection_action": {"const": "SELECT_STUDENT_MASSING_GRID_HEIGHT_HYPOTHESIS"},
        "human_selection_candidate_key": {"type": "string", "pattern": "^MGH-[0-9]{3,}$"},
        "human_selection_selected_by": {"type": "string", "minLength": 1},
        "human_selection_selected_at": {"type": "string"},
        "human_selection_source_comparison_document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The pending comparison document hash bound by the human selection record."
        },
        "selected_hypothesis_state_package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The canonical JSON plus newline SHA-256 of the whole selected hypothesis state package."
        },
        "pending_student_plan_framework_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The pre-confirmation plan-framework draft hash bound by the human confirmation record."
        },
        "confirmed_student_plan_framework_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The canonical JSON plus newline SHA-256 of the whole confirmed plan-framework draft."
        },
        "plan_framework_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The canonical JSON plus newline SHA-256 of the whole ARCH-106 plan framework this document answers."
        },
        "pending_student_schematic_plan_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The pre-confirmation schematic-plan draft hash bound by the human confirmation record."
        },
        "confirmed_student_schematic_plan_draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The canonical JSON plus newline SHA-256 of the whole confirmed schematic-plan draft."
        }
      }
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "coordinate_scope",
        "levels",
        "relations",
        "clarification_questions",
        "next_action",
        "boundaries_statement"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "schematic_plan_blocks_confirmed"},
        "coordinate_scope": {
          "type": "string",
          "const": "local_schematic_coordinates_only",
          "description": "All x, y, width, and depth values are local schematic sketch values only; never site, survey, or building coordinates."
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level_label", "container", "zones"],
            "properties": {
              "level_label": {"type": "string", "minLength": 1},
              "container": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width_m", "depth_m"],
                "properties": {
                  "width_m": {
                    "type": "string",
                    "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]*(?:\\.[0-9]{1,2})?)$",
                    "description": "Local sketch frame width in metres; finite and strictly positive (greater than zero). A zero-area frame is not a valid local plan frame."
                  },
                  "depth_m": {
                    "type": "string",
                    "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]*(?:\\.[0-9]{1,2})?)$",
                    "description": "Local sketch frame depth in metres; finite and strictly positive (greater than zero). A zero-area frame is not a valid local plan frame."
                  }
                }
              },
              "zones": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["zone_name", "spaces"],
                  "properties": {
                    "zone_name": {"type": "string", "minLength": 1},
                    "spaces": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["space_name", "x_m", "y_m", "rotation_degrees", "width_m", "depth_m"],
                        "properties": {
                          "space_name": {"type": "string", "minLength": 1},
                          "x_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                          "y_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                          "rotation_degrees": {"enum": [0, 90]},
                          "width_m": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                            "description": "Determined by the ARCH-100 human-selected long or short side and the rotation; never written by the student."
                          },
                          "depth_m": {
                            "type": "string",
                            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                            "description": "Determined by the ARCH-100 human-selected long or short side and the rotation; never written by the student."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_space", "to_space", "relation_category", "note", "verification_status"],
            "properties": {
              "from_space": {"type": "string", "minLength": 1},
              "to_space": {"type": "string", "minLength": 1},
              "relation_category": {
                "enum": ["adjacent", "near", "separate", "buffered_transition", "flexibly_divisible"]
              },
              "note": {"type": "string", "minLength": 1},
              "verification_status": {
                "enum": ["geometrically_verified", "human_authored_intent_only"],
                "description": "adjacent and separate pairs are checked geometrically; near, buffered_transition, and flexibly_divisible stay human intent with no fabricated distance or performance judgment."
              }
            }
          },
          "description": "The plan framework's relations carried verbatim with their notes and verification status."
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"const": "human_review_schematic_plan_blocks"},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries_statement": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
