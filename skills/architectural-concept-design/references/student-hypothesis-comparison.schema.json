{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-hypothesis-comparison/1.0.0",
  "title": "Student Hypothesis Comparison and Human Selection",
  "description": "A deterministic comparison document over one confirmed student massing, grid, and height hypotheses framework. It projects the student-written hypotheses, criteria, assessments, and optional non-binding guidance, and selects nothing. In the pending_selection state it waits for exactly one explicit human selection record; in the selected state it carries that record and a controlled handoff to the next separately reviewed stage. JSON data only: no PPTX, image, HTML, drawing, or three-dimensional model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_kind",
    "source_binding",
    "selection_status",
    "human_selection",
    "student_view"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "comparison_kind": {"const": "student_massing_grid_height_hypothesis_comparison"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_input_hash",
        "confirmed_digest_sha256",
        "pending_digest_sha256",
        "start_board_sha256",
        "confirmed_program_draft_sha256",
        "pending_program_draft_sha256",
        "confirmed_program_sha256",
        "pending_dimension_draft_sha256",
        "confirmed_dimension_draft_sha256",
        "confirmed_dimension_plan_sha256",
        "dimension_selection_sha256",
        "pending_floor_zoning_draft_sha256",
        "confirmed_floor_zoning_draft_sha256",
        "floor_zoning_framework_sha256",
        "pending_circulation_environment_draft_sha256",
        "confirmed_circulation_environment_draft_sha256",
        "circulation_environment_framework_sha256",
        "pending_massing_grid_height_draft_sha256",
        "confirmed_massing_grid_height_draft_sha256",
        "massing_grid_height_framework_sha256",
        "pending_student_hypothesis_comparison_draft_sha256",
        "confirmed_student_hypothesis_comparison_draft_sha256"
      ],
      "properties": {
        "digest_input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_board_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_program_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_dimension_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimension_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_floor_zoning_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "floor_zoning_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_circulation_environment_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "circulation_environment_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_massing_grid_height_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_massing_grid_height_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "massing_grid_height_framework_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pending_student_hypothesis_comparison_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "confirmed_student_hypothesis_comparison_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "selection_status": {
      "enum": ["pending_selection", "selected"],
      "description": "pending_selection means no human selection is recorded yet and the machine selects nothing; selected means one explicit human selection record is bound."
    },
    "human_selection": {
      "oneOf": [
        {"const": null},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "action", "selected_candidate_key", "selected_by", "selected_at", "source_comparison_document_sha256"],
          "properties": {
            "status": {"const": "selected"},
            "action": {"const": "SELECT_STUDENT_MASSING_GRID_HEIGHT_HYPOTHESIS"},
            "selected_candidate_key": {"type": "string", "pattern": "^MGH-[0-9]{3,}$"},
            "selected_by": {"type": "string", "minLength": 1},
            "selected_at": {"type": "string"},
            "source_comparison_document_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "The canonical JSON plus newline SHA-256 of the pending comparison document this selection answers."
            }
          }
        }
      ]
    },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "decision_prompt",
        "candidates",
        "comparison_criteria",
        "guidance",
        "clarification_questions",
        "human_selection_view",
        "next_action",
        "boundaries_statement"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "massing_grid_height_hypothesis_comparison"},
        "decision_prompt": {"type": "string", "minLength": 1},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "massing_groups", "grid_intent", "vertical_intervals", "vertical_interval_subtotal_m", "note", "student_assessment"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "massing_groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["level", "zones", "role", "note", "space_footprint_subtotal_m2"],
                  "properties": {
                    "level": {"type": "string", "minLength": 1},
                    "zones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "role": {"enum": ["primary", "secondary", "service"]},
                    "note": {"type": "string", "minLength": 1},
                    "space_footprint_subtotal_m2": {
                      "type": "string",
                      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                      "description": "Accounting subtotal of the dimension-declared footprints of the group's spaces; never building area, gross area, or actual massing."
                    }
                  }
                }
              },
              "grid_intent": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grid_pattern", "primary_bay_m", "secondary_bay_m", "note"],
                "properties": {
                  "grid_pattern": {"enum": ["rectilinear", "hybrid", "other"]},
                  "primary_bay_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                  "secondary_bay_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                  "note": {"type": "string", "minLength": 1}
                }
              },
              "vertical_intervals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["level", "floor_to_floor_m", "note"],
                  "properties": {
                    "level": {"type": "string", "minLength": 1},
                    "floor_to_floor_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                    "note": {"type": "string", "minLength": 1}
                  }
                }
              },
              "vertical_interval_subtotal_m": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                "description": "Subtotal of the student-declared floor-to-floor values; never a building height, planning height, elevation, structural height, or code conclusion."
              },
              "note": {"type": "string", "minLength": 1},
              "student_assessment": {
                "type": "object",
                "additionalProperties": false,
                "required": ["applicable_preconditions", "advantages", "costs_or_risks", "reconsider_when", "criterion_judgments"],
                "properties": {
                  "applicable_preconditions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "advantages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "costs_or_risks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "reconsider_when": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "criterion_judgments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["criterion", "judgment"],
                      "properties": {
                        "criterion": {"type": "string", "minLength": 1},
                        "judgment": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "comparison_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1}
            }
          }
        },
        "guidance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reasons"],
              "properties": {
                "status": {"const": "unable_to_suggest_single_candidate"},
                "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "basis", "basis_criteria", "advantages", "costs_or_risks", "reconsider_when", "bounds_statement"],
              "properties": {
                "status": {"const": "guidance_available"},
                "basis": {"type": "string", "minLength": 1},
                "basis_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "advantages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "costs_or_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "reconsider_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "bounds_statement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "recommended_to_consider_first": {"type": "string", "minLength": 1},
                "suggested_focus": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1}}
              },
              "allOf": [
                {
                  "oneOf": [
                    {"required": ["recommended_to_consider_first"]},
                    {"required": ["suggested_focus"]}
                  ]
                }
              ]
            }
          ]
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "human_selection_view": {
          "oneOf": [
            {"const": null},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["selected_label", "selected_by", "selected_at"],
              "properties": {
                "selected_label": {"type": "string", "minLength": 1},
                "selected_by": {"type": "string", "minLength": 1},
                "selected_at": {"type": "string"}
              }
            }
          ]
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"enum": ["human_select_massing_grid_height_hypothesis", "handoff_selected_massing_grid_height_hypothesis"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries_statement": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
