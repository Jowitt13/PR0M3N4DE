{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-massing-grid-height-draft/1.0.0",
  "title": "Student Massing, Grid and Height Hypotheses Draft",
  "description": "A human-authored draft of two to six comparable massing, grid, and height hypotheses written over one confirmed circulation and environmental intent framework. Groups are student-declared functional combinations, not coordinate volumes, building shapes, plan drawings, or final massing. The builder checks completeness, numeric form, coverage, and traceability only; it never generates, ranks, scores, recommends, or selects a hypothesis, and decides no entrance, plan coordinate, orientation, site conclusion, structural system, regulation, or constructibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_kind",
    "source_circulation_environment_sha256",
    "hypotheses",
    "clarification_questions",
    "human_confirmation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "draft_kind": {"const": "student_massing_grid_height_draft"},
    "source_circulation_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The canonical JSON plus newline SHA-256 of the complete confirmed circulation-environment framework this draft answers."
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "label", "massing_groups", "grid_intent", "vertical_intervals", "note"],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^MGH-[0-9]{3,}$"},
          "label": {"type": "string", "minLength": 1},
          "massing_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["group_id", "level_id", "zone_ids", "role", "note"],
              "properties": {
                "group_id": {"type": "string", "pattern": "^MG-[0-9]{3,}$"},
                "level_id": {"type": "string", "pattern": "^LV-[0-9]{3,}$"},
                "zone_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^Z-[0-9]{3,}$"},
                  "description": "Real zones of the same level; every confirmed zone appears in exactly one group per hypothesis."
                },
                "role": {"enum": ["primary", "secondary", "service"]},
                "note": {"type": "string", "minLength": 1}
              }
            }
          },
          "grid_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grid_pattern", "primary_bay_m", "secondary_bay_m", "note"],
            "properties": {
              "grid_pattern": {"enum": ["rectilinear", "hybrid", "other"]},
              "primary_bay_m": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                "description": "A positive finite decimal string; the builder checks positivity only and judges no structure."
              },
              "secondary_bay_m": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                "description": "A positive finite decimal string; the builder checks positivity only and judges no structure."
              },
              "note": {"type": "string", "minLength": 1}
            }
          },
          "vertical_intervals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level_id", "floor_to_floor_m", "note"],
              "properties": {
                "level_id": {"type": "string", "pattern": "^LV-[0-9]{3,}$"},
                "floor_to_floor_m": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
                  "description": "A positive finite decimal string declared by the student; never claimed as a building height."
                },
                "note": {"type": "string", "minLength": 1}
              }
            }
          },
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "clarification_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1},
      "description": "At most three human-authored questions, carried verbatim; the builder never adds questions."
    },
    "human_confirmation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "pending"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confirmed_by", "confirmed_at", "action", "pending_massing_grid_height_draft_sha256"],
          "properties": {
            "status": {"const": "confirmed"},
            "confirmed_by": {"type": "string", "minLength": 1},
            "confirmed_at": {"type": "string"},
            "action": {"const": "CONFIRM_STUDENT_MASSING_GRID_HEIGHT_DRAFT"},
            "pending_massing_grid_height_draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
