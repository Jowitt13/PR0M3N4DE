{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecture-pre-design-skills.local/schemas/student-schematic-plan-state-handoff/1.0.0",
  "title": "Student Schematic Plan State Handoff",
  "description": "A closed deterministic handoff projected only after one valid ARCH-107 schematic plan blocks document and one human continue_to_handoff review record. It carries local schematic rectangle data only; it does not make or imply a drawing, site plan, architectural decision, performance claim, or PPTX.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_kind", "source_binding", "student_handoff", "handoff_contract"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_kind": {"const": "student_schematic_plan_state_handoff"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schematic_plan_blocks_sha256",
        "review_record_sha256",
        "review_action",
        "reviewed_by",
        "reviewed_at",
        "review_outcome"
      ],
      "properties": {
        "schematic_plan_blocks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_action": {"const": "REVIEW_STUDENT_SCHEMATIC_PLAN_BLOCKS"},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "review_outcome": {"const": "continue_to_handoff"}
      }
    },
    "student_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_title",
        "stage",
        "coordinate_scope",
        "levels",
        "relations",
        "clarification_questions",
        "review_summary",
        "next_action",
        "boundaries_statement"
      ],
      "properties": {
        "project_title": {"type": "string", "minLength": 1},
        "stage": {"const": "schematic_plan_reviewed_for_handoff"},
        "coordinate_scope": {"const": "local_schematic_coordinates_only"},
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level_label", "container", "zones"],
            "properties": {
              "level_label": {"type": "string", "minLength": 1},
              "container": {
                "type": "object",
                "additionalProperties": false,
                "required": ["width_m", "depth_m"],
                "properties": {
                  "width_m": {"type": "string", "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]*(?:\\.[0-9]{1,2})?)$"},
                  "depth_m": {"type": "string", "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]*(?:\\.[0-9]{1,2})?)$"}
                }
              },
              "zones": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["zone_name", "spaces"],
                  "properties": {
                    "zone_name": {"type": "string", "minLength": 1},
                    "spaces": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["space_name", "x_m", "y_m", "rotation_degrees", "width_m", "depth_m"],
                        "properties": {
                          "space_name": {"type": "string", "minLength": 1},
                          "x_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                          "y_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                          "rotation_degrees": {"enum": [0, 90]},
                          "width_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
                          "depth_m": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_space", "to_space", "relation_category", "note", "verification_status"],
            "properties": {
              "from_space": {"type": "string", "minLength": 1},
              "to_space": {"type": "string", "minLength": 1},
              "relation_category": {"enum": ["adjacent", "near", "separate", "buffered_transition", "flexibly_divisible"]},
              "note": {"type": "string", "minLength": 1},
              "verification_status": {"enum": ["geometrically_verified", "human_authored_intent_only"]}
            }
          }
        },
        "clarification_questions": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "review_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed_by", "reviewed_at", "outcome", "review_notes"],
          "properties": {
            "reviewed_by": {"type": "string", "minLength": 1},
            "reviewed_at": {"type": "string", "minLength": 1},
            "outcome": {"const": "continue_to_handoff"},
            "review_notes": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}}
          }
        },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "description"],
          "properties": {
            "action": {"const": "human_continue_manual_schematic_design"},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "boundaries_statement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "handoff_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_available", "must_not_infer", "invalidated_by_upstream_change", "prohibited_outputs"],
      "properties": {
        "confirmed_available": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_infer": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "invalidated_by_upstream_change": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
